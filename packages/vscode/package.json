{
  "name": "mystmd-vscode",
  "displayName": "MyST Markdown (mystmd-lsp)",
  "description": "VS Code support for MyST Markdown: syntax highlighting, the mystmd-lsp language server, and a site preview.",
  "version": "0.0.1",
  "publisher": "myst-contrib",
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/myst.yml"
  ],
  "contributes": {
    "configuration": {
      "title": "MyST",
      "properties": {
        "mystmd.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to your own mystmd-lsp command. Leave empty to use the server bundled with this extension."
        }
      }
    },
    "configurationDefaults": {
      "markdown.suggest.paths.enabled": false
    },
    "grammars": [
      {
        "scopeName": "text.myst.injection",
        "path": "./syntaxes/myst.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "commands": [
      {
        "command": "mystmd.startPreview",
        "title": "MyST: Start preview"
      },
      {
        "command": "mystmd.restartServer",
        "title": "MyST: Restart language server"
      },
      {
        "command": "mystmd.showLog",
        "title": "MyST: Show language server log"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "vscode-languageclient": "^9.0.1",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "npm run build -w mystmd-lsp && esbuild extension.js --bundle --platform=node --external:vscode --outfile=dist/extension.js && node -e \"require('fs').copyFileSync('../mystmd-lsp/dist/server.cjs','dist/server.cjs')\"",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choldgraf/mystmd-lsp.git",
    "directory": "packages/vscode"
  }
}
