{
  "name": "mystmd-lsp",
  "version": "0.0.1",
  "description": "A language server for MyST Markdown projects, built on the mystmd engine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mystmd-lsp": "dist/server.cjs"
  },
  "files": [
    "dist/server.cjs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc",
    "prepack": "cp ../../README.md . && npm run build",
    "postpack": "rm -f README.md"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0",
    "myst-common": "^1.10.1",
    "myst-directives": "^1.7.4",
    "myst-ext-button": "^0.0.2",
    "myst-ext-card": "^1.0.9",
    "myst-ext-exercise": "^1.0.10",
    "myst-ext-grid": "^1.1.1",
    "myst-ext-proof": "^1.0.13",
    "myst-ext-tabs": "^1.0.10",
    "myst-parser": "^1.7.4",
    "myst-roles": "^1.7.4",
    "myst-transforms": "^1.3.51",
    "punycode": "^2.3.1",
    "typescript": "^7.0.2",
    "unified": "^10.1.2",
    "unist-util-visit": "^4.1.2",
    "vfile": "^5.3.7",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "myst",
    "mystmd",
    "lsp",
    "language-server",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myst-contrib/mystmd-lsp.git",
    "directory": "packages/mystmd-lsp"
  }
}
