{
  "version": "0.2.0",
  "configurations": [
    {
      // F5: rebuilds, then opens a copy of demo/ (/tmp/mystmd-lsp-demo) in a new window with the extension and the local server.
      "name": "Demo extension on demo/",
      "type": "extensionHost",
      "request": "launch",
      // Switch off myst-highlight, which highlights the same syntax.
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode", "--disable-extension=executablebookproject.myst-highlight", "/tmp/mystmd-lsp-demo"],
      "preLaunchTask": "demo: build and copy"
    }
  ]
}
